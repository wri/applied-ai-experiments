---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import '@wri-datalab/ui/styles';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Site-root-relative OG image path (no base), e.g. "og/prompt-comparator.png". */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, imageAlt, type, jsonLd } = Astro.props;
// Ensure base URL ends with a slash for proper path concatenation
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<!DOCTYPE html>
<html lang="en" data-variant="prototype">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo {title} {description} {image} {imageAlt} {type} {jsonLd} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>
      // Initialize theme from the "prototype-theme" key shared with the demos,
      // migrating the hub's legacy "theme" key once, then system preference.
      (function() {
        const VALID = ['light', 'dark', 'high-contrast'];
        let stored = localStorage.getItem('prototype-theme');
        if (!VALID.includes(stored)) {
          const legacy = localStorage.getItem('theme');
          stored = VALID.includes(legacy) ? legacy : null;
          if (stored) localStorage.setItem('prototype-theme', stored);
        }
        localStorage.removeItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        if (theme !== 'dark') {
          document.documentElement.setAttribute('data-theme', theme);
        }
        // Prototype default (no data-theme) is dark, so only set for light/high-contrast
      })();
    </script>
    <script
      id="counterscale-script"
      data-site-id="applied-ai-experiments"
      src="https://counterscale.tilers.workers.dev/tracker.js"
      defer></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
