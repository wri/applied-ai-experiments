---
/**
 * Centralized SEO / social meta for the hub. Emits the full OpenGraph +
 * Twitter card + canonical set, and optional JSON-LD structured data.
 *
 * `image` is a site-root-relative path (no base, no leading slash), e.g.
 * "og/prompt-comparator.png". It defaults to the generated hub card and is
 * resolved to an absolute URL (social crawlers require absolute image URLs).
 */
interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "WRI AI Experiments Hub — explore the WRI Applied AI Group's research, prototypes, and learnings.",
  image = "og/default.png",
  imageAlt,
  type = "website",
  jsonLd,
} = Astro.props;

const SITE_NAME = "WRI Applied AI Experiments";
const ORIGIN = (Astro.site ?? new URL("https://wri.github.io")).origin;

// Normalize base to a single leading+trailing slash, then build the full site root.
const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const siteRoot = `${ORIGIN}${base}`.replace(/\/$/, ""); // e.g. https://wri.github.io/applied-ai-experiments

// Canonical: ensure the base prefix is present even if Astro.url.pathname omits it.
let pathname = Astro.url.pathname;
if (base !== "/" && !pathname.startsWith(base)) {
  pathname = `${base.replace(/\/$/, "")}${pathname.startsWith("/") ? "" : "/"}${pathname}`;
}
const canonicalURL = `${ORIGIN}${pathname}`;

const fullTitle = `${title} | ${SITE_NAME}`;
const imageURL = image.startsWith("http") ? image : `${siteRoot}/${image.replace(/^\//, "")}`;
const alt = imageAlt ?? `${title} — ${SITE_NAME}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- OpenGraph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={alt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={alt} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}
