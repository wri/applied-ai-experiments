---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeTag from '../../components/ThemeTag.astro';
import { visibleInsights } from '../../utils/experiments';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const all = await getCollection('insights');
const insights = visibleInsights(all, import.meta.env.DEV);
// Featured first, then by date (visibleInsights already sorted by date desc)
insights.sort((a, b) => Number(b.data.featured) - Number(a.data.featured));

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="Insights"
  description="Curated cross-experiment synthesis from the WRI Applied AI Group — threads that run across multiple experiments."
>
  <section class="insights-intro">
    <h1>Insights</h1>
    <p class="subtitle">
      Cross-experiment synthesis — the threads that run across several experiments and that no
      single experiment's lessons capture on their own. For per-experiment takeaways, see
      <a href={`${base}learnings/`}>Learnings</a>.
    </p>
  </section>

  {insights.length === 0 ? (
    <div class="empty">
      <p>No published insights yet.</p>
      <p class="empty-hint">
        Insights are authored as markdown in the repo-root <code>insights/</code> directory.
        Copy <code>insights/_TEMPLATE.md</code>, write the synthesis, and set
        <code>status: published</code>.
      </p>
    </div>
  ) : (
    <div class="insight-grid">
      {insights.map((insight) => (
        <article class={`insight-card ${insight.data.featured ? 'featured' : ''}`}>
          {insight.data.featured && <span class="featured-flag">Featured</span>}
          <h2 class="insight-title">
            <a href={`${base}insights/${insight.id}/`}>{insight.data.title}</a>
          </h2>
          <p class="insight-summary">{insight.data.summary}</p>
          <div class="insight-meta">
            <div class="insight-themes">
              {insight.data.themes.map((t) => <ThemeTag theme={t} />)}
            </div>
            <span class="insight-count">
              {insight.data.related_experiments.length} experiment{insight.data.related_experiments.length === 1 ? '' : 's'}
              <span class="insight-date">{fmtDate(insight.data.date)}</span>
            </span>
          </div>
        </article>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .insights-intro {
    margin-bottom: 1.5rem;
  }
  .insights-intro h1 {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tx);
    margin: 0 0 0.5rem;
  }
  .subtitle {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--tx-2);
    max-width: 70ch;
    line-height: 1.55;
    margin: 0;
  }
  .subtitle a {
    color: var(--primary);
  }

  .empty {
    padding: 2rem;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    text-align: center;
  }
  .empty p {
    font-family: var(--font-body);
    color: var(--tx-2);
    margin: 0 0 0.5rem;
  }
  .empty-hint {
    font-size: 0.8125rem;
    color: var(--tx-3);
  }
  .empty code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--bg);
    padding: 0.05rem 0.25rem;
    border-radius: var(--radius-sm);
  }

  .insight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-4);
  }

  .insight-card {
    position: relative;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: box-shadow var(--transition-fast) ease;
  }
  .insight-card:hover {
    box-shadow: var(--shadow-md);
  }
  .insight-card.featured {
    border-color: var(--ui-2);
  }

  .featured-flag {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-badge);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wide);
    color: var(--tx-3);
  }

  .insight-title {
    font-family: var(--font-mono);
    font-size: var(--text-title-md);
    font-weight: var(--font-weight-medium);
    margin: 0;
    padding-right: 4rem;
    text-transform: none;
    letter-spacing: normal;
  }
  .insight-title a {
    color: var(--tx);
  }
  .insight-title a:hover {
    color: var(--primary);
    text-decoration: none;
  }

  .insight-summary {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--tx-2);
    margin: 0;
  }

  .insight-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--ui);
  }
  .insight-themes {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }
  .insight-count {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-badge);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wide);
    color: var(--tx-3);
    white-space: nowrap;
  }
  .insight-date {
    color: var(--tx-3);
  }
</style>
