---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadExperimentIndex } from '../../utils/experiments';
import taxonomy from '../../data/taxonomy.json';

export async function getStaticPaths() {
  // Generate a page for every theme declared in the taxonomy,
  // even if no experiments currently carry that theme (empty state is informative).
  const themeKeys = Object.keys(taxonomy.themes);
  return themeKeys.map((themeKey) => ({
    params: { theme: themeKey }
  }));
}

const { theme } = Astro.params;
const themeKey = theme as string;
const themeConfig = (taxonomy.themes as any)[themeKey];
const pillar = taxonomy.pillars.find((p) => p.themes.includes(themeKey));

if (!themeConfig) {
  return Astro.redirect('/404');
}

const index = await loadExperimentIndex();
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

// All experiments that include this theme (any position in themes array)
const themeExperiments = index.experiments.filter((e) =>
  (e.themes ?? []).includes(themeKey)
);

// Group by status for display ordering
const STATUS_ORDER: Record<string, number> = {
  started: 0,
  paused: 1,
  idea: 2,
  completed: 3,
  archived: 4
};

const ordered = [...themeExperiments].sort((a, b) => {
  const sa = STATUS_ORDER[a.status] ?? 99;
  const sb = STATUS_ORDER[b.status] ?? 99;
  if (sa !== sb) return sa - sb;
  return a.title.localeCompare(b.title);
});

const byStatus = {
  started: themeExperiments.filter((e) => e.status === 'started').length,
  paused: themeExperiments.filter((e) => e.status === 'paused').length,
  idea: themeExperiments.filter((e) => e.status === 'idea').length,
  completed: themeExperiments.filter((e) => e.status === 'completed').length
};

// Aggregated lessons from completed experiments in this theme
const lessons = themeExperiments
  .filter((e) => e.status === 'completed' && e.results?.lessons?.length)
  .flatMap((e) =>
    e.results!.lessons!.map((lesson) => ({
      lesson,
      experimentSlug: e.slug,
      experimentTitle: e.title
    }))
  );
---

<BaseLayout
  title={themeConfig.name}
  description={`WRI Applied AI experiments under the ${themeConfig.name} theme.`}
>
  <section class="theme-intro" style={`--theme-color: ${themeConfig.color}`}>
    <div class="breadcrumb">
      <a href={base}>Home</a>
      <span>/</span>
      <span>Themes</span>
      <span>/</span>
      <span>{themeConfig.short}</span>
    </div>
    {pillar && (
      <div class="pillar-label">{pillar.name}</div>
    )}
    <h1>{themeConfig.name}</h1>
    <div class="theme-stats">
      <span class="stat">{themeExperiments.length} experiment{themeExperiments.length === 1 ? '' : 's'}</span>
      {byStatus.started > 0 && <span class="stat stat-started">{byStatus.started} active</span>}
      {byStatus.paused > 0 && <span class="stat stat-paused">{byStatus.paused} paused</span>}
      {byStatus.idea > 0 && <span class="stat stat-idea">{byStatus.idea} idea{byStatus.idea === 1 ? '' : 's'}</span>}
      {byStatus.completed > 0 && <span class="stat stat-completed">{byStatus.completed} completed</span>}
    </div>
  </section>

  {themeExperiments.length === 0 ? (
    <div class="empty">
      <p>No experiments under this theme yet.</p>
      <p class="empty-hint">
        Scope one with <code>themes: [{themeKey}]</code> in <code>info.yaml</code>, or see
        <a href={`${base}docs/backlog/`}>the backlog</a> for candidates.
      </p>
    </div>
  ) : (
    <>
      <section class="experiments-section">
        <h2>Experiments</h2>
        <div class="experiment-list">
          {ordered.map((exp) => (
            <a href={`${base}experiments/${exp.slug}/`} class="experiment-row">
              <div class="experiment-row-main">
                <div class="experiment-title">{exp.title}</div>
                <div class="experiment-description">{exp.description}</div>
              </div>
              <div class="experiment-row-meta">
                <span class={`status-chip status-${exp.status}`}>{exp.status}</span>
                {exp.maturity && (
                  <span class="maturity-chip">{exp.maturity}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>

      {lessons.length > 0 && (
        <section class="lessons-section">
          <h2>Lessons from this theme</h2>
          <div class="lesson-list">
            {lessons.map((entry) => (
              <div class="lesson-card">
                <p class="lesson-text">{entry.lesson}</p>
                <a href={`${base}experiments/${entry.experimentSlug}/`} class="lesson-source">
                  {entry.experimentTitle}
                </a>
              </div>
            ))}
          </div>
        </section>
      )}
    </>
  )}
</BaseLayout>

<style>
  .theme-intro {
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 3px solid var(--theme-color);
  }
  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tx-3);
    margin-bottom: 1rem;
    display: flex;
    gap: 0.5rem;
  }
  .breadcrumb a {
    color: var(--tx-3);
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .pillar-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tx-3);
    margin-bottom: 0.25rem;
  }
  h1 {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--theme-color);
    margin: 0 0 0.75rem;
  }
  .theme-stats {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .stat {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    color: var(--tx-2);
    border-radius: var(--radius-sm);
  }
  .stat-started { color: var(--info, #38bdf8); }
  .stat-paused { color: var(--warning, #fbbf24); }
  .stat-completed { color: var(--success, #4ade80); }

  h2 {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tx);
    margin: 0 0 0.75rem;
  }

  .experiments-section {
    margin-bottom: 2rem;
  }

  .experiment-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .experiment-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 150ms ease, border-color 150ms ease;
  }
  .experiment-row:hover {
    background: var(--bg-3);
    border-color: var(--ui-2);
  }
  .experiment-row-main {
    flex: 1;
    min-width: 0;
  }
  .experiment-title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--tx);
    margin-bottom: 0.25rem;
  }
  .experiment-description {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--tx-2);
    line-height: 1.45;
  }
  .experiment-row-meta {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .status-chip,
  .maturity-chip {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    background: var(--bg);
    border: 1px solid var(--ui);
    border-radius: var(--radius-sm);
    color: var(--tx-3);
  }
  .status-started { color: var(--info, #38bdf8); border-color: var(--info, #38bdf8); }
  .status-paused  { color: var(--warning, #fbbf24); border-color: var(--warning, #fbbf24); }
  .status-completed { color: var(--success, #4ade80); border-color: var(--success, #4ade80); }

  .lessons-section {
    padding-top: 1.5rem;
    border-top: 1px solid var(--ui);
  }
  .lesson-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.625rem;
  }
  @media (min-width: 720px) {
    .lesson-list { grid-template-columns: 1fr 1fr; }
  }
  .lesson-card {
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .lesson-text {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--tx);
    margin: 0;
  }
  .lesson-source {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tx-2);
    text-decoration: none;
    padding-top: 0.375rem;
    border-top: 1px dashed var(--ui);
  }
  .lesson-source:hover {
    color: var(--primary);
  }
  .empty {
    padding: 2rem;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    text-align: center;
  }
  .empty p {
    font-family: var(--font-body);
    color: var(--tx-2);
    margin: 0 0 0.5rem;
  }
  .empty-hint {
    font-size: 0.8125rem;
    color: var(--tx-3);
  }
  .empty code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--bg);
    padding: 0.05rem 0.25rem;
    border-radius: var(--radius-sm);
  }
</style>
