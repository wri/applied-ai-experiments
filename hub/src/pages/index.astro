---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperimentCard from '../components/ExperimentCard.astro';
import DemoCard from '../components/DemoCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import ThemeTag from '../components/ThemeTag.astro';
import taxonomy from '../data/taxonomy.json';
import {
  loadExperimentIndex,
  collectLessons,
  lessonHighlights,
  getThemeConfig,
  visibleInsights,
} from '../utils/experiments';

const index = await loadExperimentIndex();
const experiments = index.experiments;
const themeCount = Object.keys(index.by_theme).length;
// Ensure base URL ends with a slash for proper path concatenation
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

// --- Stats ------------------------------------------------------------------
const demoCount = experiments.filter((e) => e._has_demo).length;
const { total: lessonTotal } = collectLessons(index);

// --- Portfolio pulse: status distribution -----------------------------------
// Quiet palette: completed/paused carry semantic colour; the rest are neutral
// greys distinguished by position and the legend, not by competing hues.
const statusMeta: Record<string, { label: string; color: string }> = {
  completed: { label: 'Completed', color: 'var(--success)' },
  started: { label: 'Started', color: 'var(--tx-2)' },
  idea: { label: 'Idea', color: 'var(--tx-3)' },
  paused: { label: 'Paused', color: 'var(--warning)' },
  archived: { label: 'Archived', color: 'var(--ui-2)' },
};
const statusBar = ['completed', 'started', 'idea', 'paused', 'archived']
  .map((key) => ({ key, ...statusMeta[key], count: (index.by_status[key as keyof typeof index.by_status] ?? []).length }))
  .filter((s) => s.count > 0);
const statusTotal = statusBar.reduce((sum, s) => sum + s.count, 0) || 1;

// --- Portfolio pulse: theme distribution (ordered by pillar) -----------------
const themeStats = taxonomy.pillars
  .flatMap((p) => p.themes)
  .map((key) => ({ key, cfg: getThemeConfig(key), count: (index.by_theme[key] ?? []).length }))
  .filter((t) => t.count > 0);
const maxTheme = Math.max(...themeStats.map((t) => t.count), 1);

// --- Featured insight + latest learnings ------------------------------------
const allInsights = await getCollection('insights');
const insights = visibleInsights(allInsights, import.meta.env.DEV);
const featuredInsight = insights.find((i) => i.data.featured) ?? insights[0] ?? null;
const highlights = lessonHighlights(index, 4);

// --- Featured experiments: completed + live demos first, then recency --------
const recency = (e: typeof experiments[number]) =>
  new Date(e.updated_at || e.created_at || 0).getTime();
const ranked = [...experiments].sort((a, b) => {
  const score = (e: typeof experiments[number]) =>
    (e.status === 'completed' ? 2 : 0) + (e._has_demo ? 1 : 0);
  return score(b) - score(a) || recency(b) - recency(a);
});

// Hero spotlight: the strongest demo (completed first, recordings preferred).
const demoRanked = experiments
  .filter((e) => e._has_demo)
  .sort((a, b) => {
    const score = (e: typeof experiments[number]) =>
      (e.status === 'completed' ? 2 : 0) + (e._has_media ? 1 : 0);
    return score(b) - score(a) || recency(b) - recency(a);
  });
const heroDemo = demoRanked[0] ?? null;

// Demo showcase strip: the next demos after the hero pick.
const showcaseDemos = demoRanked.filter((e) => e !== heroDemo).slice(0, 3);

// Featured grid: skip what the hero/showcase already display.
const shown = new Set([heroDemo, ...showcaseDemos].filter(Boolean).map((e: any) => e.slug));
const featured = ranked.filter((e) => !shown.has(e.slug)).slice(0, 3);

// --- Latest completed (spotlight in the pulse panel) ------------------------
const latestCompleted = [...experiments]
  .filter((e) => e.status === 'completed')
  .sort((a, b) => recency(b) - recency(a))[0] ?? null;
const spotlightType = latestCompleted?.type === 'marimo' ? 'notebook' : latestCompleted?.type;
const spotlightLessons = latestCompleted?.results?.lessons?.length ?? 0;
const spotlightTheme = latestCompleted?.themes?.[0]
  ? getThemeConfig(latestCompleted.themes[0])?.short ?? latestCompleted.themes[0]
  : null;

// --- Recently updated --------------------------------------------------------
const recentlyUpdated = [...experiments]
  .filter((e) => e.updated_at)
  .sort((a, b) => recency(b) - recency(a))
  .slice(0, 5);
---

<BaseLayout title="Home">
  <section class:list={['hero', { 'has-spotlight': !!heroDemo }]}>
    <div class="hero-copy">
      <h1>AI Experiments Hub</h1>
      <p class="subtitle">
        A living record of what the WRI Applied AI Group has tried — and what we learned.
        {index.count} experiment{index.count !== 1 ? 's' : ''} across {themeCount} theme{themeCount !== 1 ? 's' : ''}.
      </p>
      <div class="hero-actions">
        <a href={`${base}experiments/`} class="btn btn-primary">Browse experiments</a>
        {featuredInsight && (
          <a href={`${base}insights/${featuredInsight.id}/`} class="btn btn-secondary">Latest insight</a>
        )}
      </div>
    </div>
    {heroDemo && (
      <div class="hero-spotlight">
        <span class="eyebrow spotlight-eyebrow">Featured demo</span>
        <DemoCard experiment={heroDemo} compact />
      </div>
    )}
  </section>

  <section class="stats">
    <a href={`${base}experiments/`} class="stat-card stat-link">
      <span class="stat-value">{index.count}</span>
      <span class="stat-label">Experiments</span>
    </a>
    <a href={`${base}portfolio/`} class="stat-card stat-link">
      <span class="stat-value">{themeCount}</span>
      <span class="stat-label">Themes</span>
    </a>
    <a href={`${base}learnings/`} class="stat-card stat-link">
      <span class="stat-value">{lessonTotal}</span>
      <span class="stat-label">Lessons captured</span>
    </a>
    <a href={`${base}experiments/?demos=true`} class="stat-card stat-link">
      <span class="stat-value">{demoCount}</span>
      <span class="stat-label">Interactive demos</span>
    </a>
  </section>

  <section class="pulse">
    <div class="pulse-panel">
      <h2 class="pulse-title">Portfolio pulse</h2>
      <div class="status-bar" role="img" aria-label="Experiment status distribution">
        {statusBar.map((s) => (
          <div class="status-seg" style={`width: ${(s.count / statusTotal) * 100}%; background: ${s.color}`} title={`${s.label}: ${s.count}`}></div>
        ))}
      </div>
      <div class="status-legend">
        {statusBar.map((s) => (
          <span class="legend-item">
            <span class="legend-dot" style={`background: ${s.color}`}></span>
            {s.label} <strong>{s.count}</strong>
          </span>
        ))}
      </div>

      {latestCompleted && (
        <>
          <div class="pulse-sub">
            <span class="pulse-sub-label">Latest completed</span>
          </div>
          <a href={`${base}experiments/${latestCompleted.slug}/`} class="spotlight">
            <span class="spotlight-title">{latestCompleted.title}</span>
            <span class="spotlight-meta">
              <span class="spotlight-facts">
                {spotlightType}{spotlightLessons > 0 ? ` · ${spotlightLessons} lesson${spotlightLessons === 1 ? '' : 's'}` : ''}{spotlightTheme ? ` · ${spotlightTheme}` : ''}
              </span>
              <span class="spotlight-arrow">→</span>
            </span>
          </a>
        </>
      )}
    </div>

    <div class="pulse-panel">
      <h2 class="pulse-title">By theme</h2>
      <div class="theme-bars">
        {themeStats.map((t) => (
          <a href={`${base}themes/${t.key}/`} class="theme-bar-row">
            <span class="theme-bar-label">{t.cfg?.short ?? t.key}</span>
            <span class="theme-bar-track">
              <span class="theme-bar-fill" style={`width: ${(t.count / maxTheme) * 100}%`}></span>
            </span>
            <span class="theme-bar-count">{t.count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {showcaseDemos.length > 0 && (
    <section class="experiments-section">
      <div class="section-header">
        <h2>Demo Showcase</h2>
        <a href={`${base}demos/`} class="btn btn-secondary">
          All Demos
        </a>
      </div>
      <div class="experiments-grid">
        {showcaseDemos.map(exp => (
          <DemoCard experiment={exp} />
        ))}
      </div>
    </section>
  )}

  <section class="experiments-section">
    <div class="section-header">
      <h2>Featured Experiments</h2>
      <a href={`${base}experiments/`} class="btn btn-secondary">
        View All
      </a>
    </div>
    <div class="experiments-grid">
      {featured.map(exp => (
        <ExperimentCard experiment={exp} />
      ))}
    </div>
  </section>

  <section class="knowledge">
    {featuredInsight && (
      <div class="insight-banner">
        <div class="insight-banner-head">
          <span class="eyebrow">Featured insight</span>
          <a href={`${base}insights/`} class="see-all">All insights →</a>
        </div>
        <h2 class="insight-banner-title">
          <a href={`${base}insights/${featuredInsight.id}/`}>{featuredInsight.data.title}</a>
        </h2>
        <p class="insight-banner-summary">{featuredInsight.data.summary}</p>
        <div class="insight-banner-themes">
          {featuredInsight.data.themes.map((t) => <ThemeTag theme={t} />)}
        </div>
      </div>
    )}

    {highlights.length > 0 && (
      <div class="learnings-strip">
        <div class="learnings-head">
          <span class="eyebrow">Latest learnings</span>
          <a href={`${base}learnings/`} class="see-all">All learnings →</a>
        </div>
        <ul class="learnings-list">
          {highlights.map((h) => (
            <li class="learning-item">
              <p class="learning-text">{h.lesson}</p>
              <a href={`${base}experiments/${h.slug}/`} class="learning-source">{h.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  {recentlyUpdated.length > 0 && (
    <section class="recently-updated">
      <h2>Recently Updated</h2>
      <div class="updated-list">
        {recentlyUpdated.map(exp => (
          <a href={`${base}experiments/${exp.slug}/`} class="updated-item">
            <span class="updated-title">{exp.title}</span>
            <span class="updated-meta">
              <StatusBadge status={exp.status} label={false} />
              <span class="updated-type">{exp.type}</span>
              {exp.updated_at && <span class="updated-date">{exp.updated_at}</span>}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: var(--space-6) 0 var(--space-8);
  }
  .hero .subtitle {
    font-family: var(--font-body);
    color: var(--tx-2);
    max-width: 60ch;
    margin: var(--space-2) auto 0;
    line-height: 1.55;
  }
  .hero-actions {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    margin-top: var(--space-4);
  }

  /* Two-column hero when a featured demo is available */
  .hero.has-spotlight {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-6);
    align-items: center;
    text-align: left;
  }
  .hero.has-spotlight .subtitle {
    margin: var(--space-2) 0 0;
  }
  .hero.has-spotlight .hero-actions {
    justify-content: flex-start;
  }
  .hero-spotlight {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .spotlight-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wider);
    color: var(--tx-3);
  }
  @media (max-width: 768px) {
    .hero.has-spotlight {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero.has-spotlight .subtitle {
      margin: var(--space-2) auto 0;
    }
    .hero.has-spotlight .hero-actions {
      justify-content: center;
    }
    .hero-spotlight {
      text-align: left;
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .stat-card {
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-align: center;
  }

  .stat-link {
    text-decoration: none;
    transition: border-color var(--transition-fast) ease;
  }
  .stat-link:hover {
    border-color: var(--primary);
    text-decoration: none;
  }

  .stat-value {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-medium);
    color: var(--primary);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wide);
    color: var(--tx-3);
    margin-top: var(--space-1);
  }

  /* --- Portfolio pulse --- */
  .pulse {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  @media (max-width: 768px) {
    .pulse {
      grid-template-columns: 1fr;
    }
  }

  .pulse-panel {
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .pulse-title {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wide);
    color: var(--tx-3);
    margin: 0 0 var(--space-3);
  }

  .status-bar {
    display: flex;
    height: 0.75rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--bg);
  }
  .status-seg {
    height: 100%;
  }
  .status-seg + .status-seg {
    border-left: 1px solid var(--bg-2);
  }

  .status-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-badge);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wide);
    color: var(--tx-2);
  }
  .legend-item strong {
    color: var(--tx);
  }
  .legend-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .pulse-sub {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--ui);
    margin-bottom: var(--space-2);
  }
  .pulse-sub-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wide);
    color: var(--tx-3);
  }
  .spotlight {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
  }
  .spotlight:hover .spotlight-title,
  .spotlight:hover .spotlight-arrow {
    color: var(--primary);
  }
  .spotlight-title {
    font-family: var(--font-mono);
    font-size: var(--text-title-md);
    font-weight: var(--font-weight-medium);
    color: var(--tx);
    line-height: 1.3;
  }
  .spotlight-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-badge);
    color: var(--tx-3);
  }
  .spotlight-facts {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .spotlight-arrow {
    flex-shrink: 0;
    color: var(--tx-3);
  }
  .theme-bars {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .theme-bar-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr 1.5rem;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }
  a.theme-bar-row:hover .theme-bar-label {
    color: var(--tx);
  }
  .theme-bar-label {
    font-family: var(--font-mono);
    font-size: var(--text-badge);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wide);
    color: var(--tx-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .theme-bar-track {
    height: 0.5rem;
    background: var(--bg);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .theme-bar-fill {
    display: block;
    height: 100%;
    background: var(--tx-3);
  }
  .theme-bar-count {
    font-family: var(--font-mono);
    font-size: var(--text-badge);
    color: var(--tx-3);
    text-align: right;
  }

  /* --- Knowledge: insight banner + learnings strip --- */
  .knowledge {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  @media (max-width: 768px) {
    .knowledge {
      grid-template-columns: 1fr;
    }
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wider);
    color: var(--tx-3);
  }
  .see-all {
    font-family: var(--font-mono);
    font-size: var(--text-badge);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wide);
    color: var(--tx-3);
  }
  .see-all:hover {
    color: var(--primary);
    text-decoration: none;
  }

  .insight-banner {
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .insight-banner-head,
  .learnings-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .insight-banner-title {
    font-family: var(--font-mono);
    font-size: var(--text-title-md);
    font-weight: var(--font-weight-medium);
    text-transform: none;
    letter-spacing: normal;
    margin: 0;
  }
  .insight-banner-title a {
    color: var(--tx);
  }
  .insight-banner-title a:hover {
    color: var(--primary);
    text-decoration: none;
  }
  .insight-banner-summary {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--tx-2);
    margin: 0;
  }
  .insight-banner-themes {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
    margin-top: var(--space-1);
  }

  .learnings-strip {
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }
  .learnings-list {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: flex;
    flex-direction: column;
  }
  .learning-item {
    padding: var(--space-3) 0;
    border-bottom: 1px dashed var(--ui);
  }
  .learning-item:first-child {
    padding-top: 0;
  }
  .learning-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .learning-text {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--tx);
    margin: 0 0 var(--space-1);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .learning-source {
    font-family: var(--font-mono);
    font-size: var(--text-badge);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wide);
    color: var(--tx-3);
  }
  .learning-source:hover {
    color: var(--primary);
    text-decoration: none;
  }

  /* --- Featured experiments --- */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }
  .experiments-section {
    margin-bottom: var(--space-8);
  }
  .experiments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-4);
  }

  /* --- Recently updated --- */
  .recently-updated {
    margin-bottom: var(--space-8);
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .recently-updated h2 {
    padding: var(--padding-panel-header);
    background: var(--bg-3);
    border-bottom: 1px solid var(--ui);
    margin-bottom: 0;
    font-size: var(--text-title-sm);
  }
  .updated-list {
    display: flex;
    flex-direction: column;
  }
  .updated-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--padding-panel-header);
    text-decoration: none;
    border-bottom: 1px solid var(--ui);
    transition: background var(--transition-fast) ease;
  }
  .updated-item:last-child {
    border-bottom: none;
  }
  .updated-item:hover {
    background: var(--bg-3);
    text-decoration: none;
  }
  .updated-title {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--tx);
    font-weight: var(--font-weight-medium);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .updated-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }
  .updated-type {
    font-family: var(--font-mono);
    font-size: var(--text-badge);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wide);
    color: var(--tx-3);
  }
  .updated-date {
    font-family: var(--font-mono);
    font-size: var(--text-badge);
    color: var(--tx-3);
  }
  @media (max-width: 520px) {
    .updated-type,
    .updated-date {
      display: none;
    }
  }
</style>
