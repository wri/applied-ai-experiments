---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import MediaGallery from '../../components/MediaGallery.astro';
import { loadExperimentIndex, loadBriefContent, splitBriefMarkdown, visibleInsights } from '../../utils/experiments';
import { getCollection } from 'astro:content';
import taxonomy from '../../data/taxonomy.json';
import { marked } from 'marked';

export async function getStaticPaths() {
  const index = await loadExperimentIndex();

  // Build a slug → experiment map for related-experiment resolution
  const bySlug = new Map(index.experiments.map((e) => [e.slug, e]));

  // Curated insights that reference each experiment
  const allInsights = await getCollection('insights');
  const insights = visibleInsights(allInsights, import.meta.env.DEV);

  const paths = await Promise.all(
    index.experiments.map(async (exp) => {
      let beforeHtml: string | null = null;
      let afterHtml: string | null = null;
      if (exp._has_brief) {
        const md = await loadBriefContent(exp.slug);
        if (md) {
          const { before, after } = splitBriefMarkdown(md);
          beforeHtml = before ? await marked(before) : null;
          afterHtml = after ? await marked(after) : null;
        }
      }

      // Resolve related experiments from depends_on (upstream) + reverse-lookup (downstream)
      // Fall back to legacy related_experiments list if depends_on is absent.
      const upstream = (exp.depends_on ?? [])
        .map((slug) => bySlug.get(slug))
        .filter(Boolean)
        .map((e: any) => ({ slug: e.slug, title: e.title, status: e.status }));
      const downstream = index.experiments
        .filter((e) => (e.depends_on ?? []).includes(exp.slug))
        .map((e) => ({ slug: e.slug, title: e.title, status: e.status }));
      const legacyRelated = (exp.related_experiments ?? [])
        .map((slug) => bySlug.get(slug))
        .filter(Boolean)
        .filter((e: any) =>
          !upstream.some((u) => u.slug === e.slug) &&
          !downstream.some((d) => d.slug === e.slug)
        )
        .map((e: any) => ({ slug: e.slug, title: e.title, status: e.status }));

      const relatedInsights = insights
        .filter((i) => i.data.related_experiments.includes(exp.slug))
        .map((i) => ({ id: i.id, title: i.data.title }));

      return {
        params: { slug: exp.slug },
        props: { experiment: exp, beforeHtml, afterHtml, upstream, downstream, legacyRelated, relatedInsights },
      };
    })
  );
  return paths;
}

const { experiment, beforeHtml, afterHtml, upstream, downstream, legacyRelated, relatedInsights } = Astro.props;
// Ensure base URL ends with a slash for proper path concatenation
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

// Lookup helpers for sidebar display
const maturityConfig = experiment.maturity ? (taxonomy.maturity as any)[experiment.maturity] : null;
const investmentConfig = experiment.investment_type
  ? (taxonomy.investment_types as any)[experiment.investment_type]
  : null;

// Check if sidebar has any content
const hasThemes = experiment.themes && experiment.themes.length > 0;
const hasTags = experiment.tags && experiment.tags.length > 0;
const hasRelated = upstream.length > 0 || downstream.length > 0 || legacyRelated.length > 0;
const hasInsights = relatedInsights.length > 0;
const hasPortfolioFields = !!(experiment.maturity || experiment.investment_type || experiment.origin || experiment.surface);
const hasSidebarContent = hasThemes || hasTags || hasRelated || hasInsights || hasPortfolioFields;

// Check for main content sections
const isCompleted = experiment.status === 'completed';
const hasResultsSummary = !!(experiment.results?.summary && experiment.results.summary.trim());
const hasLessons = experiment.results?.lessons && experiment.results.lessons.length > 0;
const hasBrief = !!beforeHtml;
const hasAfter = !!afterHtml;
// For completed experiments, lead with an "outcome at a glance" callout instead of
// burying the summary in a late section.
const showOutcomeCallout = isCompleted && hasResultsSummary;
const showSummarySection = hasResultsSummary && !showOutcomeCallout;
const recordings = experiment.media?.recordings ?? [];
const hasMedia = recordings.length > 0;
const hasMainContent = hasBrief || hasAfter || hasResultsSummary || hasLessons || hasMedia;
---

<BaseLayout title={experiment.title} description={experiment.description}>
  <article class="experiment-detail">
    <header class="experiment-header">
      <div class="breadcrumb">
        <a href={base}>Home</a>
        <span>/</span>
        <a href={`${base}experiments/`}>Experiments</a>
        <span>/</span>
        <span>{experiment.slug}</span>
      </div>

      <h1>{experiment.title}</h1>

      <div class="meta">
        <span class={`badge badge-type-${experiment.type}`}>
          {experiment.type}
        </span>
        <StatusBadge status={experiment.status} />
      </div>

      <p class="description">{experiment.description}</p>

      <div class="actions">
        {experiment._has_demo && !experiment._is_notebook && (
          <a href={`${base}${experiment.slug}/`} class="btn btn-primary">
            View Demo
          </a>
        )}
        {experiment._is_notebook && (
          <a href={`${base}notebook/${experiment.slug}/`} class="btn btn-primary">
            View Notebook
          </a>
        )}
        <a href={`https://github.com/wri/applied-ai-experiments/tree/main/experiments/${experiment.slug}`}
           class="btn btn-secondary"
           target="_blank"
           rel="noopener noreferrer">
          View Source
        </a>
      </div>
    </header>

    <div class={`content-grid ${!hasSidebarContent ? 'no-sidebar' : ''}`}>
      <main class="main-content">
        {!hasMainContent && (
          <div class="empty-content">
            <p>This experiment doesn't have detailed documentation yet.</p>
            <p>Check out the <a href={`https://github.com/wri/applied-ai-experiments/tree/main/experiments/${experiment.slug}`} target="_blank" rel="noopener noreferrer">source code</a> for more information.</p>
          </div>
        )}

        {showOutcomeCallout && (
          <section class="section outcome-callout">
            <div class="outcome-head">
              <span class="outcome-label">Outcome at a glance</span>
              <StatusBadge status={experiment.status} />
            </div>
            <p class="outcome-summary">{experiment.results?.summary}</p>
          </section>
        )}

        {hasMedia && <MediaGallery recordings={recordings} />}

        {hasBrief && (
          <section class="section brief-content">
            <div set:html={beforeHtml} />
          </section>
        )}

        {hasAfter && (
          <section class="section after-section brief-content">
            <div class="after-label">Outcome</div>
            <div set:html={afterHtml} />
          </section>
        )}

        {showSummarySection && (
          <section class="section">
            <h2>Results Summary</h2>
            <p>{experiment.results?.summary}</p>
          </section>
        )}

        {hasLessons && (
          <section class="section" id="lessons">
            <h2>Lessons Learned</h2>
            <div class="lessons-grid">
              {(experiment.results?.lessons ?? []).map((lesson: string, i: number) => (
                <div class="lesson-card" id={`lesson-${i}`}>{lesson}</div>
              ))}
            </div>
          </section>
        )}
      </main>

      {hasSidebarContent && (
        <aside class="sidebar">
          <div class="sidebar-card">
            <h3>Details</h3>
            <dl class="details-list">
              <dt>Type</dt>
              <dd>{experiment.type}</dd>
              <dt>Status</dt>
              <dd>{experiment.status}</dd>

              {experiment.runtime && (
                <>
                  <dt>Runtime</dt>
                  <dd>{experiment.runtime}</dd>
                </>
              )}
              {maturityConfig && (
                <>
                  <dt>Maturity</dt>
                  <dd>{maturityConfig.name}</dd>
                </>
              )}
              {investmentConfig && (
                <>
                  <dt>Investment</dt>
                  <dd>{investmentConfig.label}</dd>
                </>
              )}
              {experiment.origin && (
                <>
                  <dt>Origin</dt>
                  <dd>{experiment.origin}</dd>
                </>
              )}
              {experiment.surface && (
                <>
                  <dt>Surface</dt>
                  <dd>{experiment.surface}</dd>
                </>
              )}
            </dl>
          </div>

          {hasThemes && (
            <div class="sidebar-card">
              <h3>Themes</h3>
              <div class="tags">
                {(experiment.themes ?? []).map((themeKey: string) => {
                  const cfg = (taxonomy.themes as any)[themeKey];
                  return (
                    <a
                      href={`${base}themes/${themeKey}/`}
                      class="tag tag-link"
                    >
                      {cfg?.short ?? themeKey}
                    </a>
                  );
                })}
              </div>
            </div>
          )}

          {hasTags && (
            <div class="sidebar-card">
              <h3>Tags</h3>
              <div class="tags">
                {(experiment.tags ?? []).map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          )}

          {hasRelated && (
            <div class="sidebar-card">
              <h3>Related</h3>
              {upstream.length > 0 && (
                <div class="related-group">
                  <div class="related-group-label">Requires</div>
                  <ul class="related-list">
                    {upstream.map((r: any) => (
                      <li>
                        <a href={`${base}experiments/${r.slug}/`}>{r.title}</a>
                        <span class={`related-status related-status-${r.status}`}>{r.status}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {downstream.length > 0 && (
                <div class="related-group">
                  <div class="related-group-label">Unlocks</div>
                  <ul class="related-list">
                    {downstream.map((r: any) => (
                      <li>
                        <a href={`${base}experiments/${r.slug}/`}>{r.title}</a>
                        <span class={`related-status related-status-${r.status}`}>{r.status}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {legacyRelated.length > 0 && (
                <div class="related-group">
                  <div class="related-group-label">Related</div>
                  <ul class="related-list">
                    {legacyRelated.map((r: any) => (
                      <li>
                        <a href={`${base}experiments/${r.slug}/`}>{r.title}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )}

          {hasInsights && (
            <div class="sidebar-card">
              <h3>Insights</h3>
              <ul class="related-list insight-links">
                {relatedInsights.map((i: any) => (
                  <li>
                    <a href={`${base}insights/${i.id}/`}>{i.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .experiment-detail {
    max-width: 1000px;
    margin: 0 auto;
  }

  .experiment-header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--ui);
  }

  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tx-3);
    margin-bottom: var(--space-4);
    display: flex;
    gap: var(--space-2);
  }

  .breadcrumb a {
    color: var(--tx-3);
    transition: color 150ms ease;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }

  .description {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--tx-2);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .actions {
    display: flex;
    gap: var(--space-2);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: var(--space-6);
  }

  .content-grid.no-sidebar {
    grid-template-columns: 1fr;
  }

  @media (max-width: 768px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }

  .empty-content {
    padding: var(--space-6);
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    text-align: center;
    color: var(--tx-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .empty-content p {
    margin-bottom: var(--space-2);
  }

  .section {
    margin-bottom: var(--space-6);
  }

  .section h2 {
    font-size: 0.875rem;
    margin-bottom: var(--space-3);
  }

  .section p,
  .section li {
    font-family: var(--font-body);
    color: var(--tx);
    line-height: 1.6;
    font-size: 0.875rem;
  }

  .outcome-callout {
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .outcome-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .outcome-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tx-3);
  }

  .outcome-summary {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--tx);
    margin: 0;
  }

  .lessons-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .lessons-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lesson-card {
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--tx);
    scroll-margin-top: calc(var(--header-height) + var(--space-3));
  }

  .lesson-card:target {
    border-color: var(--primary);
  }

  .insight-links a {
    color: var(--tx);
    display: block;
    padding: 0.25rem 0;
  }
  .insight-links a:hover {
    color: var(--primary);
  }

  .sidebar-card {
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-3);
  }

  .sidebar-card h3 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tx-2);
    padding: 0.5rem 0.75rem;
    background: var(--bg-3);
    border-bottom: 1px solid var(--ui);
    margin-bottom: 0;
  }

  .details-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-3);
    padding: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .details-list dt {
    color: var(--tx-3);
    text-transform: uppercase;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
  }

  .details-list dd {
    color: var(--tx);
    text-transform: capitalize;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: 0.75rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--bg);
    border: 1px solid var(--ui);
    color: var(--tx-2);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .tag-link {
    color: var(--tx-2);
  }

  .tag-link:hover {
    background: var(--bg-3);
    border-color: var(--ui-2);
  }

  .related-group {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--ui);
  }

  .related-group:last-child {
    border-bottom: none;
  }

  .related-group-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tx-3);
    margin-bottom: 0.25rem;
  }

  .related-list {
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .related-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.25rem 0;
  }

  .related-list a {
    color: var(--tx);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-list a:hover {
    color: var(--primary);
  }

  .related-status {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tx-3);
    padding: 0.05rem 0.3rem;
    background: var(--bg);
    border-radius: var(--radius-sm);
  }

  .related-status-completed {
    color: var(--success, #4ade80);
  }

  .related-status-started {
    color: var(--info, #38bdf8);
  }

  .related-status-paused {
    color: var(--warning, #fbbf24);
  }

  .after-section {
    position: relative;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.25rem 0.25rem;
    margin-top: var(--space-6);
  }

  .after-label {
    position: absolute;
    top: -0.625rem;
    left: 1rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tx-3);
    background: var(--bg);
    padding: 0 0.5rem;
  }

  .brief-content :global(h1) {
    font-size: 1.125rem;
    font-weight: var(--font-weight-semibold);
    margin-top: 0;
    margin-bottom: var(--space-3);
    color: var(--tx);
  }

  .brief-content :global(h2),
  .brief-content :global(h3),
  .brief-content :global(h4) {
    font-size: 0.8125rem;
    font-weight: var(--font-weight-semibold);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
    color: var(--tx);
  }

  .brief-content :global(p) {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--tx);
    margin-bottom: var(--space-3);
  }

  .brief-content :global(ul),
  .brief-content :global(ol) {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--tx);
    margin-bottom: var(--space-3);
    padding-left: var(--space-4);
  }

  .brief-content :global(li) {
    margin-bottom: var(--space-1);
  }

  .brief-content :global(hr) {
    border: none;
    border-top: 1px solid var(--ui);
    margin: var(--space-4) 0;
  }

  .brief-content :global(strong) {
    font-weight: var(--font-weight-semibold);
  }

  .brief-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8em;
    background: var(--bg-2);
    padding: 0.125rem 0.25rem;
    border-radius: var(--radius-sm);
  }
</style>
