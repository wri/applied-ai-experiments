---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadExperimentIndex, loadBriefContent, splitBriefMarkdown, visibleInsights, renderLearningInline } from '../../utils/experiments';
import { getCollection } from 'astro:content';
import taxonomy from '../../data/taxonomy.json';
import { marked } from 'marked';

export async function getStaticPaths() {
  const index = await loadExperimentIndex();

  // Curated insights that reference each experiment
  const allInsights = await getCollection('insights');
  const insights = visibleInsights(allInsights, import.meta.env.DEV);

  const paths = await Promise.all(
    index.experiments.map(async (exp) => {
      let beforeHtml: string | null = null;
      let afterHtml: string | null = null;
      if (exp._has_brief) {
        const md = await loadBriefContent(exp.slug);
        if (md) {
          const { before, after } = splitBriefMarkdown(md);
          beforeHtml = before ? await marked(before) : null;
          afterHtml = after ? await marked(after) : null;
        }
      }

      const relatedInsights = insights
        .filter((i) => i.data.related_experiments.includes(exp.slug))
        .map((i) => ({ id: i.id, title: i.data.title }));

      return {
        params: { slug: exp.slug },
        props: { experiment: exp, beforeHtml, afterHtml, relatedInsights },
      };
    })
  );
  return paths;
}

const { experiment, beforeHtml, afterHtml, relatedInsights } = Astro.props;
// Ensure base URL ends with a slash for proper path concatenation
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

// What the experiment targets (capability / infra / feature)
const targetsConfig = experiment.targets
  ? (taxonomy.targets as any)[experiment.targets]
  : null;

// Check if sidebar has any content
const hasThemes = experiment.themes && experiment.themes.length > 0;
const hasTags = experiment.tags && experiment.tags.length > 0;
const hasInsights = relatedInsights.length > 0;
const hasSidebarContent = hasThemes || hasTags || hasInsights || !!targetsConfig;

// Check for main content sections
const isDone = experiment.status === 'done';
const hasResultsSummary = !!(experiment.results?.summary && experiment.results.summary.trim());
const hasLearnings = experiment.results?.learnings && experiment.results.learnings.length > 0;
const hasBrief = !!beforeHtml;
const hasAfter = !!afterHtml;
// For done experiments, lead with an "outcome at a glance" callout instead of
// burying the summary in a late section.
const showOutcomeCallout = isDone && hasResultsSummary;
const showSummarySection = hasResultsSummary && !showOutcomeCallout;
const hasMainContent = hasBrief || hasAfter || hasResultsSummary || hasLearnings;

// Structured data: demos are web apps, everything else is a creative work.
const detailUrl = `https://wri.github.io${base}experiments/${experiment.slug}/`;
const isApp = experiment._has_demo && !experiment._is_notebook;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': isApp ? 'WebApplication' : 'CreativeWork',
  name: experiment.title,
  description: experiment.description,
  url: detailUrl,
  ...(isApp ? { applicationCategory: 'DeveloperApplication', operatingSystem: 'Web', browserRequirements: 'Requires JavaScript' } : {}),
  author: { '@type': 'Organization', name: 'World Resources Institute', url: 'https://www.wri.org' },
  ...(experiment.created_at ? { dateCreated: String(experiment.created_at) } : {}),
  ...(experiment.updated_at ? { dateModified: String(experiment.updated_at) } : {}),
};
---

<BaseLayout
  title={experiment.title}
  description={experiment.description}
  image={`og/${experiment.slug}.png`}
  type="article"
  jsonLd={jsonLd}
>
  <article class="experiment-detail">
    <header class="experiment-header">
      <div class="breadcrumb">
        <a href={base}>Home</a>
        <span>/</span>
        <a href={`${base}experiments/`}>Experiments</a>
        <span>/</span>
        <span>{experiment.slug}</span>
      </div>

      <h1>{experiment.title}</h1>

      {/* Status is a fact about the work, not a headline about it — it lives in
          the Details panel. The header carries what the thing *is*. */}
      <div class="meta">
        <span class={`badge badge-type-${experiment.type}`}>
          {experiment.type}
        </span>
      </div>

      <p class="description">{experiment.description}</p>

      <div class="actions">
        {experiment._has_demo && !experiment._is_notebook && (
          <a href={`${base}${experiment.slug}/`} class="btn btn-primary">
            View Demo
          </a>
        )}
        {experiment._is_notebook && (
          <a href={`${base}notebook/${experiment.slug}/`} class="btn btn-primary">
            View Notebook
          </a>
        )}
        <a href={`https://github.com/wri/applied-ai-experiments/tree/main/experiments/${experiment.slug}`}
           class="btn btn-secondary"
           target="_blank"
           rel="noopener noreferrer">
          View Source
        </a>
      </div>
    </header>

    <div class={`content-grid ${!hasSidebarContent ? 'no-sidebar' : ''}`}>
      <main class="main-content">
        {!hasMainContent && (
          <div class="empty-content">
            <p>This experiment doesn't have detailed documentation yet.</p>
            <p>Check out the <a href={`https://github.com/wri/applied-ai-experiments/tree/main/experiments/${experiment.slug}`} target="_blank" rel="noopener noreferrer">source code</a> for more information.</p>
          </div>
        )}

        {showOutcomeCallout && (
          <section class="section outcome-callout">
            <span class="outcome-label">Outcome at a glance</span>
            <p class="outcome-summary">{experiment.results?.summary}</p>
          </section>
        )}

        {hasBrief && (
          <section class="section brief-content">
            <div set:html={beforeHtml} />
          </section>
        )}

        {hasAfter && (
          <section class="section after-section brief-content">
            <div class="after-label">Outcome</div>
            <div set:html={afterHtml} />
          </section>
        )}

        {showSummarySection && (
          <section class="section">
            <h2>Results Summary</h2>
            <p>{experiment.results?.summary}</p>
          </section>
        )}

        {hasLearnings && (
          <section class="section" id="learnings">
            <h2>Learnings</h2>
            <div class="learnings-grid">
              {(experiment.results?.learnings ?? []).map((learning: string, i: number) => (
                <div class="learning-card" id={`learning-${i}`} set:html={renderLearningInline(learning)} />
              ))}
            </div>
          </section>
        )}
      </main>

      {hasSidebarContent && (
        <aside class="sidebar">
          <div class="sidebar-card">
            <h3>Details</h3>
            <dl class="details-list">
              <dt>Type</dt>
              <dd>{experiment.type}</dd>
              <dt>Status</dt>
              <dd>{experiment.status}</dd>

              {targetsConfig && (
                <>
                  <dt>Targets</dt>
                  <dd title={targetsConfig.question}>{targetsConfig.label}</dd>
                </>
              )}
            </dl>
          </div>

          {hasThemes && (
            <div class="sidebar-card">
              <h3>Themes</h3>
              <div class="tags">
                {(experiment.themes ?? []).map((themeKey: string) => {
                  const cfg = (taxonomy.themes as any)[themeKey];
                  return (
                    <a
                      href={`${base}themes/${themeKey}/`}
                      class="tag tag-link"
                    >
                      {cfg?.short ?? themeKey}
                    </a>
                  );
                })}
              </div>
            </div>
          )}

          {hasTags && (
            <div class="sidebar-card">
              <h3>Tags</h3>
              <div class="tags">
                {(experiment.tags ?? []).map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          )}

          {hasInsights && (
            <div class="sidebar-card">
              <h3>Insights</h3>
              <ul class="related-list insight-links">
                {relatedInsights.map((i: any) => (
                  <li>
                    <a href={`${base}insights/${i.id}/`}>{i.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .experiment-detail {
    max-width: 1000px;
    margin: 0 auto;
  }

  .experiment-header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--ui);
  }

  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tx-3);
    margin-bottom: var(--space-4);
    display: flex;
    gap: var(--space-2);
  }

  .breadcrumb a {
    color: var(--tx-3);
    transition: color 150ms ease;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }

  .description {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--tx-2);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .actions {
    display: flex;
    gap: var(--space-2);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: var(--space-6);
  }

  .content-grid.no-sidebar {
    grid-template-columns: 1fr;
  }

  @media (max-width: 768px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }

  .empty-content {
    padding: var(--space-6);
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    text-align: center;
    color: var(--tx-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .empty-content p {
    margin-bottom: var(--space-2);
  }

  .section {
    margin-bottom: var(--space-6);
  }

  .section h2 {
    font-size: 0.875rem;
    margin-bottom: var(--space-3);
  }

  .section p,
  .section li {
    font-family: var(--font-body);
    color: var(--tx);
    line-height: 1.6;
    font-size: 0.875rem;
  }

  .outcome-callout {
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .outcome-label {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tx-3);
  }

  .outcome-summary {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--tx);
    margin: 0;
  }

  .learnings-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .learnings-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .learning-card {
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--tx);
    scroll-margin-top: calc(var(--header-height) + var(--space-3));
  }

  .learning-card:target {
    border-color: var(--primary);
  }

  .insight-links a {
    color: var(--tx);
    display: block;
    padding: 0.25rem 0;
  }
  .insight-links a:hover {
    color: var(--primary);
  }

  .sidebar-card {
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-3);
  }

  .sidebar-card h3 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tx-2);
    padding: 0.5rem 0.75rem;
    background: var(--bg-3);
    border-bottom: 1px solid var(--ui);
    margin-bottom: 0;
  }

  .details-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-3);
    padding: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .details-list dt {
    color: var(--tx-3);
    text-transform: uppercase;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
  }

  .details-list dd {
    color: var(--tx);
    text-transform: capitalize;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: 0.75rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--bg);
    border: 1px solid var(--ui);
    color: var(--tx-2);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .tag-link {
    color: var(--tx-2);
  }

  .tag-link:hover {
    background: var(--bg-3);
    border-color: var(--ui-2);
  }




  /* Matches the 0.75rem inset the other sidebar-card bodies (.tags,
     .details-list) use — without it the text butts against the card border. */
  .related-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .related-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.25rem 0;
  }

  .related-list a {
    color: var(--tx);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-list a:hover {
    color: var(--primary);
  }





  .after-section {
    position: relative;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.25rem 0.25rem;
    margin-top: var(--space-6);
  }

  .after-label {
    position: absolute;
    top: -0.625rem;
    left: 1rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tx-3);
    background: var(--bg);
    padding: 0 0.5rem;
  }

  /* A close-out section that can't be answered yet, with the reason the author
     gave. Deliberately quiet — it's an honest status line, not a warning. Empty
     sections with no stated reason are dropped upstream and never reach the page. */
  :global(.after-section .pending-note) {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    border-left: 2px solid var(--ui-2);
    padding-left: 0.75rem;
    color: var(--tx-2);
    font-style: italic;
  }

  :global(.after-section .pending-label) {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-style: normal;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tx-3);
  }

  /* Long-form reading scale — see DESIGN.md §3 "Reading vs UI type scales". */
  .brief-content {
    max-width: var(--text-prose-measure);
  }

  .brief-content :global(h1) {
    font-size: var(--text-prose-h1);
    font-weight: var(--font-weight-semibold);
    margin-top: 0;
    margin-bottom: var(--space-3);
    color: var(--tx);
  }

  .brief-content :global(h2),
  .brief-content :global(h3),
  .brief-content :global(h4) {
    font-size: var(--text-prose-h3);
    font-weight: var(--font-weight-semibold);
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    color: var(--tx);
  }

  .brief-content :global(p) {
    font-family: var(--font-body);
    font-size: var(--text-prose-size);
    line-height: var(--text-prose-line-height);
    color: var(--tx);
    margin-bottom: var(--text-prose-gap);
  }

  .brief-content :global(ul),
  .brief-content :global(ol) {
    font-family: var(--font-body);
    font-size: var(--text-prose-size);
    line-height: var(--text-prose-line-height);
    color: var(--tx);
    margin-bottom: var(--text-prose-gap);
    padding-left: 1.5rem;
  }

  .brief-content :global(li) {
    margin-bottom: var(--space-1);
  }

  .brief-content :global(hr) {
    border: none;
    border-top: 1px solid var(--ui);
    margin: var(--space-4) 0;
  }

  .brief-content :global(strong) {
    font-weight: var(--font-weight-semibold);
  }

  .brief-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8em;
    background: var(--bg-2);
    padding: 0.125rem 0.25rem;
    border-radius: var(--radius-sm);
  }

  /* Tables — mirrors the insight prose rules in pages/insights/[slug].astro.
     Cells wrap rather than scroll, so keep tables to about three columns. */
  .brief-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    table-layout: auto;
    margin-bottom: var(--text-prose-gap);
    font-size: var(--text-prose-size);
  }
  .brief-content :global(th) {
    font-family: var(--component-table-font-family);
    font-size: var(--text-label);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: var(--font-letterSpacing-wide);
    color: var(--tx-2);
    background: var(--component-table-header-background);
    border-bottom: 1px solid var(--ui);
  }
  .brief-content :global(td) {
    font-family: var(--font-body);
    line-height: var(--text-prose-line-height);
    color: var(--tx);
    border-bottom: 1px solid var(--ui);
    vertical-align: top;
  }
  .brief-content :global(th),
  .brief-content :global(td) {
    padding: var(--component-table-cell-padding-y) var(--component-table-cell-padding-x);
    text-align: left;
    overflow-wrap: break-word;
  }
  .brief-content :global(tbody tr:last-child td) {
    border-bottom: none;
  }
</style>
