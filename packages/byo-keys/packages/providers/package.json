{
  "name": "@byo-keys/providers",
  "version": "0.1.0",
  "description": "LLM provider implementations for BYOK",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./anthropic": {
      "types": "./src/anthropic.ts",
      "import": "./src/anthropic.ts"
    },
    "./openai": {
      "types": "./src/openai.ts",
      "import": "./src/openai.ts"
    },
    "./ollama": {
      "types": "./src/ollama.ts",
      "import": "./src/ollama.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "llm",
    "ai",
    "anthropic",
    "openai",
    "ollama",
    "gemini",
    "provider"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@byo-keys/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
