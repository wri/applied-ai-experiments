{
  "name": "@byo-keys/svelte",
  "version": "0.1.0",
  "description": "Svelte/SvelteKit integration for byo-keys",
  "type": "module",
  "svelte": "./src/index.ts",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "llm",
    "ai",
    "byok",
    "stores"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@byo-keys/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
