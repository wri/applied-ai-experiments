-- q28: per-cadaster candidate reconciliation for the FLAGGED cadasters (mirrors
-- l09, but scoped to the non-compliant set the workflow acts on). Every flagged
-- cadaster is accounted for, so a match failure is reported (no_match=1), never
-- silent.
CREATE OR REPLACE VIEW _q AS
WITH flagged AS (
    SELECT DISTINCT m.cod_imovel
    FROM read_parquet('${MATCHED_PARQUET}') m
    JOIN read_parquet('${EUDR_CROPS_PARQUET}') k
      ON k.mbmode24 = CAST(m.mbmode24 AS INTEGER)
    WHERE k.in_scope AND m.has_post2020_loss
)
SELECT f.cod_imovel,
       count(cand.cod_imovel)                                       AS n_candidates,
       count(*) FILTER (WHERE cand.tier = 'membership_muni')        AS n_relationship,
       count(*) FILTER (WHERE cand.tier IN
             ('intake_point', 'slaughter_point', 'mill_point'))     AS n_delivery,
       max(CASE WHEN cand.flags LIKE '%widened%' THEN 1 ELSE 0 END) AS widened,
       CASE WHEN count(*) FILTER (WHERE cand.tier IN
             ('intake_point', 'slaughter_point', 'mill_point')) = 0
            THEN 1 ELSE 0 END                                       AS no_match,
       max(CASE WHEN cand.flags LIKE '%nearest_by_far%' THEN 1 ELSE 0 END)
                                                                    AS proximity_override
FROM flagged f
LEFT JOIN read_parquet('${CANDIDATES_PARQUET}') cand USING (cod_imovel)
GROUP BY f.cod_imovel
ORDER BY n_candidates DESC, f.cod_imovel;
